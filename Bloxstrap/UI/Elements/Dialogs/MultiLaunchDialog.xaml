<base:WpfUiWindow
    x:Class="Bloxstrap.UI.Elements.Dialogs.MultiLaunchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Multi-Instance Account Launcher"
    Width="560"
    Height="560"
    MinWidth="480"
    MinHeight="440"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Margin="-16,-16,-16,8" Padding="8" Title="Astralstrap — Multi-Instance Launcher" CanMaximize="False" Icon="pack://application:,,,/Bloxstrap.ico" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Automated Multi-Account Launching" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Text="Launch multiple Roblox client instances concurrently across your saved accounts with configurable launch delays." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <ui:Card Grid.Row="2" Margin="0,0,0,12" Padding="0">
            <ListBox x:Name="AccountsList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Text=" (@" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding Username}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text=")" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ui:Card>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Target Place ID (Optional):" FontWeight="SemiBold"/>
                    <TextBox x:Name="PlaceIdBox" Margin="0,4,8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="140">
                    <TextBlock Text="Stagger Delay (sec):" FontWeight="SemiBold"/>
                    <TextBox x:Name="DelayBox" Text="4" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="LaunchProgressBar" Height="4" Visibility="Collapsed" Margin="0,4,0,4"/>
            <TextBlock x:Name="StatusLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <ui:Button Content="Select All" Appearance="Secondary" HorizontalAlignment="Left" Click="SelectAll_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Close" Appearance="Secondary" Margin="0,0,8,0" Click="CloseButton_Click"/>
                <ui:Button x:Name="LaunchButton" Content="Launch Instances" Appearance="Primary" Icon="Play24" Click="LaunchButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</base:WpfUiWindow>
