<base:WpfUiWindow
    x:Class="Bloxstrap.UI.Elements.Dialogs.ModPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Mod Asset Previewer"
    Width="720"
    Height="520"
    MinWidth="500"
    MinHeight="400"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" Title="Astralstrap — Mod Asset Previewer" CanMaximize="True" Icon="pack://application:,,,/Bloxstrap.ico" />

        <Grid Grid.Row="1" Margin="16,4,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Select Installed Mod:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
            <ComboBox Grid.Column="1" x:Name="ModSelector" SelectionChanged="ModSelector_SelectionChanged"/>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,16,12">
            <ListBox x:Name="AssetListBox" SelectionChanged="AssetListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="4" Padding="6" Width="140" Height="150" VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="96" Height="96" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" ClipToBounds="True">
                                    <Image Source="{Binding ImageSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock Text="{Binding FileName}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding FileSizeText}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="3" Margin="16,0,16,16">
            <TextBlock x:Name="StatusText" Text="Select a mod to inspect previewable assets." Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            <ui:Button Content="Close" Appearance="Secondary" HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</base:WpfUiWindow>
