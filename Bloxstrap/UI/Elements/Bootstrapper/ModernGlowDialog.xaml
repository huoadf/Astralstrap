<base:WpfUiWindow
    x:Class="Bloxstrap.UI.Elements.Bootstrapper.ModernGlowDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resources="clr-namespace:Bloxstrap.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="500"
    Height="260"
    MinHeight="0"
    Background="Transparent"
    Closing="UiWindow_Closing"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    mc:Ignorable="d">

    <Window.Resources>
        <!-- Pulsing Glow Animation for the App Icon -->
        <Storyboard x:Key="GlowPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="IconGlowEffect"
                Storyboard.TargetProperty="BlurRadius"
                From="12" To="28"
                Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="IconGlowEffect"
                Storyboard.TargetProperty="Opacity"
                From="0.45" To="0.95"
                Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="IconGlowRing"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                From="1.0" To="1.08"
                Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="IconGlowRing"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                From="1.0" To="1.08"
                Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource GlowPulseStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Path=TaskbarProgressState}" ProgressValue="{Binding Path=TaskbarProgressValue}" />
    </Window.TaskbarItemInfo>

    <Border
        Margin="12"
        CornerRadius="20"
        BorderThickness="1"
        BorderBrush="#33FFFFFF"
        Background="#D010141C">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="#000000" Opacity="0.65" ShadowDepth="6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar drag handle -->
            <ui:TitleBar Grid.Row="0" CanMaximize="False" ShowClose="False" ShowMaximize="False" ShowMinimize="False"/>

            <!-- Center Content Area -->
            <Grid Grid.Row="1" Margin="30,10,30,10" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Animated Icon Container -->
                <Grid Grid.Column="0" Width="72" Height="72" Margin="0,0,24,0" VerticalAlignment="Center">
                    <!-- Outer Glow Ring -->
                    <Border
                        x:Name="IconGlowRing"
                        Width="64"
                        Height="64"
                        CornerRadius="18"
                        Background="#2000B4D8"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect
                                x:Name="IconGlowEffect"
                                Color="#00B4D8"
                                BlurRadius="16"
                                Opacity="0.6"
                                ShadowDepth="0"/>
                        </Border.Effect>
                    </Border>

                    <!-- Icon Base Frame -->
                    <Border
                        Width="60"
                        Height="60"
                        CornerRadius="16"
                        Background="#25FFFFFF"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Image
                            Source="{Binding Icon, Mode=OneWay}"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>

                <!-- Text & Information -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        Text="Roblox"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="#00B4D8"
                        Margin="0,0,0,4"/>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#F0F4F8"
                        FontFamily="Segoe UI Variable Display, Segoe UI"
                        Text="{Binding Message, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Bottom Progress & Action Controls -->
            <Border Grid.Row="2" Padding="28,0,28,22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Gradient Animated Progress Bar -->
                    <ProgressBar
                        Grid.Row="0"
                        Height="6"
                        Margin="0,0,0,16"
                        IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                        Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                        Value="{Binding ProgressValue, Mode=OneWay}"
                        Foreground="#00B4D8"/>

                    <!-- Action Button Row -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="1"
                            Width="90"
                            Height="32"
                            Padding="0"
                            Content="{x:Static resources:Strings.Common_Cancel}"
                            Command="{Binding CancelInstallCommand}"
                            IsEnabled="{Binding CancelEnabled}"
                            Background="#22FFFFFF"
                            Foreground="#E2E8F0"
                            BorderThickness="1"
                            BorderBrush="#33FFFFFF">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</base:WpfUiWindow>
