<base:WpfUiWindow
    x:Class="Bloxstrap.UI.Elements.Dialogs.AltAccountGeneratorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Alt Account Generator &amp; Setup"
    Width="580"
    Height="580"
    MinWidth="500"
    MinHeight="480"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Margin="-16,-16,-16,8" Padding="8" Title="Astralstrap — Alt Account Generator" CanMaximize="False" Icon="pack://application:,,,/Astralstrap.png" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Generate Throwaway / Alt Credentials" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Quickly generate valid username ideas, strong passwords, and registration profiles for creating alt accounts." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <ui:Card Margin="0,0,0,8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Suggested Alt Username" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GeneratedUsernameBox" IsReadOnly="True" VerticalAlignment="Center"/>
                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Icon="ArrowClockwise24" ToolTip="Generate New Username" Click="RegenerateUsername_Click"/>
                            <ui:Button Grid.Column="2" Margin="4,0,0,0" Icon="Copy24" ToolTip="Copy Username" Click="CopyUsername_Click"/>
                        </Grid>
                    </Grid>
                </ui:Card>

                <ui:Card Margin="0,0,0,8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Randomized Strong Password" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GeneratedPasswordBox" IsReadOnly="True" VerticalAlignment="Center"/>
                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Icon="ArrowClockwise24" ToolTip="Generate New Password" Click="RegeneratePassword_Click"/>
                            <ui:Button Grid.Column="2" Margin="4,0,0,0" Icon="Copy24" ToolTip="Copy Password" Click="CopyPassword_Click"/>
                        </Grid>
                    </Grid>
                </ui:Card>

                <ui:Card Margin="0,0,0,12" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Suggested Birthday Preset (13+)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GeneratedBirthdayBox" IsReadOnly="True" VerticalAlignment="Center"/>
                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Icon="Copy24" ToolTip="Copy Birthday" Click="CopyBirthday_Click"/>
                        </Grid>
                    </Grid>
                </ui:Card>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Margin="0,0,4,0" Appearance="Primary" Icon="Open24" Content="Open Roblox Sign-Up" HorizontalAlignment="Stretch" Click="OpenRobloxSignup_Click"/>
                    <ui:Button Grid.Column="1" Margin="4,0,0,0" Appearance="Secondary" Icon="Copy24" Content="Copy All Details" HorizontalAlignment="Stretch" Click="CopyAllDetails_Click"/>
                </Grid>

                <Separator Margin="0,4,0,12"/>

                <TextBlock Text="Quick Save Alt Cookie To Astralstrap" FontSize="15" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Paste your new account's .ROBLOSECURITY token here to instantly add it to your Alt Account list." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBox x:Name="SecurityCookieBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>
                <ui:Button Appearance="Success" Icon="Add24" Content="Save Account to Astralstrap" HorizontalAlignment="Stretch" Click="SaveAccount_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            <ui:Button Content="Close" Appearance="Secondary" HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</base:WpfUiWindow>
