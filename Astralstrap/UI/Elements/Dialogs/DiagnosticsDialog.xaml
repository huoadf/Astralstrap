<base:WpfUiWindow
    x:Class="Bloxstrap.UI.Elements.Dialogs.DiagnosticsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Diagnostics &amp; Crash Analyzer"
    Width="680"
    Height="580"
    MinWidth="550"
    MinHeight="450"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Margin="-16,-16,-16,8" Padding="8" Title="Astralstrap — Diagnostics &amp; Crash Analyzer" CanMaximize="True" Icon="pack://application:,,,/Astralstrap.png" />

        <TabControl Grid.Row="1">
            <TabItem Header="System &amp; Environment">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Astralstrap Info" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="AppInfoText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Roblox Deployment Info" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="RobloxInfoText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="System Environment" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="SysInfoText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Crash Dumps &amp; Logs">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="CrashLogsList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,2" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FilePath}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Timestamp}" FontSize="11" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding FileSizeText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ui:Button Appearance="Primary" Icon="ArrowDownload24" Content="Export Diagnostic Package (.zip)" HorizontalAlignment="Left" Click="ExportZip_Click"/>
            <ui:Button Content="Close" Appearance="Secondary" HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</base:WpfUiWindow>
