<base:WpfUiWindow
    x:Class="Bloxstrap.UI.Elements.Dialogs.CustomSoundsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Custom Sound Pack &amp; Death Audio"
    Width="560"
    Height="520"
    MinWidth="480"
    MinHeight="400"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Margin="-16,-16,-16,8" Padding="8" Title="Astralstrap — Custom Sounds &amp; Audio" CanMaximize="False" Icon="pack://application:,,,/Astralstrap.ico" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Customize Game Audio Effects" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Select or upload custom sound effects for in-game death (OOF), jump, and UI clicks." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <ui:Card Margin="0,0,0,8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Death Sound (OOF / Character Reset)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DeathSoundSelector" SelectedIndex="0" SelectionChanged="DeathSoundSelector_SelectionChanged">
                                <ComboBoxItem Content="Default (Modern 'Eugh')"/>
                                <ComboBoxItem Content="Classic Old 'OOF' Sound"/>
                                <ComboBoxItem Content="Custom Sound File (.ogg / .mp3 / .wav)"/>
                            </ComboBox>
                            <ui:Button Grid.Column="1" Margin="6,0,0,0" Icon="Folder24" ToolTip="Browse Sound File" Click="BrowseCustomSound_Click"/>
                            <ui:Button Grid.Column="2" Margin="4,0,0,0" Appearance="Primary" Icon="Play24" ToolTip="Preview Sound" Click="PlaySound_Click"/>
                        </Grid>
                        <TextBlock x:Name="CustomSoundPathText" Text="" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,12" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Audio Mod Status" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CurrentModStatus" Text="Ready to configure and apply sound mod." Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:Card>

                <ui:Button Appearance="Success" Icon="Checkmark24" Content="Apply Sound Mod to Game" HorizontalAlignment="Stretch" Click="ApplySoundMod_Click"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ui:Button Content="Close" Appearance="Secondary" HorizontalAlignment="Right" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</base:WpfUiWindow>
